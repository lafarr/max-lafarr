{
	"$schema": "https://opencode.ai/config.json",
	"plugin": [
		"opencode-browser"
	],
	"mcp": {
		"supabase": {
			"type": "remote",
			"url": "https://mcp.supabase.com/mcp",
			"enabled": true
		},
		"convex": {
			"type": "local",
			"command": ["npx", "convex", "mcp", "start"],
			"enabled": true
		}	
	}
}
